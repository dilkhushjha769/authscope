# ==============================================================================
# AuthScope Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment
AUTHSCOPE_ENV=development
LOG_LEVEL=INFO

# Target Scope Settings (Strictly Enforced)
TARGET_BASE_URL=http://localhost:3000
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
ALLOWED_PORTS=[3000]
ALLOWED_SCHEMES=["http"]
ALLOWED_METHODS=["GET"]

# Role Credentials & Static Test Tokens for OWASP Juice Shop
USER_A_EMAIL=user1@juice-sh.op
USER_A_PASSWORD=user1_password_placeholder
USER_A_TOKEN=

USER_B_EMAIL=user2@juice-sh.op
USER_B_PASSWORD=user2_password_placeholder
USER_B_TOKEN=

ADMIN_EMAIL=admin@juice-sh.op
ADMIN_PASSWORD=admin_password_placeholder
ADMIN_TOKEN=

# Anthropic Claude API Configuration (For reasoning and analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT=30.0

# Storage Configuration
DATABASE_PATH=data/authscope.db

# Execution Guardrails
REQUEST_TIMEOUT_SECONDS=10.0
MAX_REQUESTS_PER_MINUTE=120
MAX_RESPONSE_SIZE_BYTES=1048576
MAX_BODY_DISPLAY_CHARS=25000
FOLLOW_REDIRECTS=false
SAFE_MODE=true

# Test & Evidence Simulation Configuration (Placeholders)
TEST_AUTH_JWT=your_test_jwt_placeholder_here
TEST_AUTH_COOKIE=your_test_cookie_placeholder_here
TEST_API_KEY=your_test_api_key_placeholder_here
TEST_USER_PASSWORD=your_test_password_placeholder_here
